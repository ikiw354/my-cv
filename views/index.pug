
block content
  doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title= title

    link(rel='stylesheet', href='/botrap/css/bootstrap.min.css')
    link(rel='stylesheet', href='/stylesheets/style.css')
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css")
    

  body

    // 🔥 NAVBAR TRANSPARAN + GLASS EFFECT
    nav.navbar.navbar-expand-lg.navbar-dark.fixed-top
      .container
        a.navbar-brand.fw-bold(href="#")
          span.text-info Muhammad
          |  Rizki

        button.navbar-toggler(type="button", data-bs-toggle="collapse", data-bs-target="#navbarNav")
          span.navbar-toggler-icon

        .collapse.navbar-collapse#navbarNav
          ul.navbar-nav.ms-auto.align-items-center
            li.nav-item
              a.nav-link(href="#about") About
            li.nav-item
              a.nav-link(href="#skill") Skills
            li.nav-item
              a.nav-link(href="#project") Projects
            li.nav-item
              a.nav-link(href="#contact") Contact

            li.nav-item.ms-3
              a.btn.btn-info.text-dark.fw-semibold(href="#contact") Hire Me

    // 🔥 SPACING BIAR KONTEN GAK KETUTUP NAVBAR
    .pt-5.mt-4

    block content

    script(src='/botrap/js/bootstrap.bundle.min.js')

    // 🔥 SCRIPT SCROLL EFFECT
    script.
      window.addEventListener('scroll', function () {
        const navbar = document.querySelector('.navbar');
        if (window.scrollY > 50) {
          navbar.classList.add('scrolled');
        } else {
          navbar.classList.remove('scrolled');
        }
      });



block content

  // 🔥 HERO (LEFT TEXT - RIGHT FOTO)
  section#hero.d-flex.align-items-center
    .container
      .row.align-items-center

        .col-md-6.text-md-start.text-center
          h1.display-3.fw-bold
            | Hai Saya Muhammad Rizki 👋
          p.lead.text-secondary Web Developer | Mahasiswa Informatika

          p.mt-3
            | Saya fokus membangun website modern, responsive, dan user-friendly
            | menggunakan teknologi terbaru.

          .mt-4
            a.btn.btn-info.text-dark.me-2(href="#project") Lihat Project
            a.btn.btn-outline-light(href="#contact") Hubungi Saya

        .col-md-6.text-center
          img(src="/images/profile.jpeg", class="img-fluid rounded-circle shadow-lg", width="500")


  // 🔥 ABOUT (CARD STYLE)
  section#about
    .container
      h2.text-center.mb-5 About Me

      .row.justify-content-center
        .col-md-8
          .card.bg-dark.text-white.shadow
            .card-body.p-4
              p
                | Saya adalah mahasiswa informatika yang memiliki passion di bidang web development.
                | Saya terbiasa membangun aplikasi menggunakan HTML, CSS, JavaScript, dan Node.js.

              p
                | Saya juga memiliki pengalaman membuat project seperti Smart Home IoT,
                | Website CV, dan automation workflow menggunakan n8n.


  // 🔥 SKILLS (MODERN GRID)
  section#skill
    .container
      h2.text-center.mb-5 Skills

      .row.text-center
        each skill in ["HTML", "CSS", "JavaScript", "Node.js", "Express", "Bootstrap"]
          .col-md-4.mb-4
            .card.bg-dark.text-white.h-100.shadow-sm
              .card-body
                h5= skill


  // 🔥 PROJECTS (ADVANCED)
section#project
  .container
    h2.text-center.mb-5 Projects

    .row
      // PROJECT 1
      .col-md-4.mb-4
        .card.project-card.bg-dark.text-white.h-100
          img.card-img-top(src="/images/kos kosan.png", alt="project")
          .card-body
            h5 Website Management Kost
            p Website manajemen kost yang memudahkan pemilik dalam mengelola kamar, penghuni, serta memantau pembayaran dan laporan keuangan secara praktis dalam satu tampilan.

            .mb-3
              span.badge.bg-info.text-dark.me-1 MySQL
              span.badge.bg-info.text-dark.me-1 HTML
              span.badge.bg-info.text-dark JavaScript
              span.badge.bg-info.text-dark Bootstrap

            a.btn.btn-sm.btn-outline-info.me-2(href="#") Demo
            a.btn.btn-sm.btn-info.text-dark(href="#") GitHub

      // PROJECT 2
      .col-md-4.mb-4
        .card.project-card.bg-dark.text-white.h-100
          img.card-img-top(src="/images/Foto website cv.png", alt="project")
          .card-body
            h5 Website CV
            p Dibangun menggunakan Express & Pug

            .mb-3
              span.badge.bg-info.text-dark.me-1 Node.js
              span.badge.bg-info.text-dark.me-1 Express
              span.badge.bg-info.text-dark Pug

            a.btn.btn-sm.btn-outline-info.me-2(href="#") Demo
            a.btn.btn-sm.btn-info.text-dark(href="#") GitHub

      // PROJECT 3
      .col-md-4.mb-4
        .card.project-card.bg-dark.text-white.h-100
          img.card-img-top(src="/images/automatic.webp", alt="project")
          .card-body
            h5 Automation Workflow
            p Automasi workflow menggunakan n8n

            .mb-3
              span.badge.bg-info.text-dark.me-1 n8n
              span.badge.bg-info.text-dark.me-1 Automation
              span.badge.bg-info.text-dark.me-1 Telegram 
              span.badge.bg-info.text-dark.me-1 Spreedsheet 

            a.btn.btn-sm.btn-outline-info.me-2(href="#") Demo
            a.btn.btn-sm.btn-info.text-dark(href="#") GitHub

  // 🔥 CONTACT (UPGRADED)
section#contact
  .container
    h2.text-center.mb-5 Contact Me

    .row.justify-content-center
      .col-md-8
        .card.bg-dark.text-white.shadow-lg
          .card-body.p-5.text-center

            h4.mb-3 Yuk Kerja Sama 🚀
            p.text-secondary
              | Tertarik bekerja sama atau ingin diskusi project?
              | Jangan ragu untuk menghubungi saya.

            // 🔥 EMAIL
            p.mt-4
              i.bi.bi-envelope-fill.me-2
              span.text-info romadhonrizki354@email.com

            // 🔥 BUTTON
            a.btn.btn-info.text-dark.mt-3.mb-4(href="mailto:romadhonrizki354@email.com")
              | Kirim Email

            hr

            // 🔥 SOCIAL MEDIA
            .d-flex.justify-content-center.gap-4.mt-3
              a.text-white.fs-4(href="www.linkedin.com/in/muhammad-rizki-romadhon-2b352b3a7")
                i.bi.bi-linkedin
              a.text-white.fs-4(href="https://t.me/Rizki R" target="_blank")
                i.bi.bi-telegram 
              a.text-white.fs-4(href="https://www.instagram.com/rzkiromadhon/")
                i.bi.bi-instagram
              a.text-white.fs-4(href="https://wa.me/6289657190114" target="_blank")
                i.bi.bi-whatsapp
                
              body.d-flex.flex-column.min-vh-100
  main.flex-fill
    // semua isi website kamu di sini

  footer.bg-dark.text-white.text-center.py-3
    p.mb-0 © 2026 Copyright