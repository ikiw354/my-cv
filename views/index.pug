extends layout 

block content
  .pt-1.mt-4
  section#hero.d-flex.align-items-center
    .container
      .row.align-items-center

        .col-md-6.text-md-start.text-center
          h1.display-3.fw-bold(
            data-aos="fade-up"
            data-aos-anchor-placement="top-center"
          )
            | Hai, Saya Muhammad Rizki 
          p.lead.text-secondary Junior Fullstack Web Developer | Mahasiswa Informatika

          p.mt-3
            | Saya fokus membangun website modern, responsive, dan user-friendly menggunakan teknologi terbaru.

          .mt-4
            a.btn.btn-info.text-dark.me-2(href="#project") Lihat Project
            a.btn.btn-outline-light(href="#contact") Hubungi Saya

        .col-md-6.text-center.mt-4.mt-md-0(
          data-aos="fade-left"
          )
          img(
          src="/images/profile.jpeg",
          class="img-fluid rounded-circle shadow-lg",
          width="500"
          )


  // 🔥 ABOUT (FRAMER STYLE - IMAGE LEFT)
  section#about.py
  .container

    .row.align-items-center.g-5

      // IMAGE (KIRI)
      .col-md-6.text-center(
        data-aos="fade-up-right"
      )
        .profile-wrapper
          img.profile-img(
            src="/images/about me.jpeg"
            alt="Profile"
          )

      // TEXT (KANAN)
      .col-md-6
        h1.text-white.fw-bold.mb-3(style="font-size:2.5rem;")
          | About
          span(style="color:#00ffd5;") Me

        p.text-light.mb-4(style="opacity:.8;")
          | Mahasiswa Informatika yang fokus pada 
          strong Web Development
          | . Saya membangun website modern menggunakan JavaScript, Node.js, Express.js, Pug, dan PostgreSQL.

        p.text-light(style="opacity:.6;")
          | Berpengalaman dalam membangun aplikasi web, mengelola database PostgreSQL, serta mengembangkan backend menggunakan Node.js dan Express.js.

        // BUTTON
        a.btn.mt-4.px-4.py-2(
          href="#project"
          style="background:#00ffd5; color:#000; border-radius:50px; font-weight:600;"
        ) View Projects


  include components/skill 

  include components/project

    // 🔥 CONTACT (UPGRADED)
  section#contact
    .container
      h2.text-center.mb-5 Contact Me

      .row.justify-content-center
        .col-md-8
          .card.bg-dark.text-white.shadow-lg
            .card-body.p-5.text-center

              h4.mb-3 Yuk Kerja Sama 🚀
              p.text-secondary
                | Tertarik bekerja sama atau ingin diskusi project?
                | Jangan ragu untuk menghubungi saya.

              // 🔥 EMAIL
              p.mt-4
                i.bi.bi-envelope-fill.me-2
                span.text-info romadhonrizki354@email.com

              // 🔥 BUTTON
              a.btn.btn-info.text-dark.mt-3.mb-4(href="mailto:romadhonrizki354@email.com")
                | Kirim Email

              hr
              include components/sosial 
             
                  