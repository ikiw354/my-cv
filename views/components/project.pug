        .col-md-4.mb-4(
          data-aos="flip-left"
          data-aos-easing="ease-out-cubic"
          data-aos-duration="2000"
        )
          .card.project-card.bg-dark.text-white.h-100
            img.card-img-top(src="/images/kos kosan.png", alt="project")
            .card-body
              h5 Website Management Kost
              p Website manajemen kost yang memudahkan pemilik dalam mengelola kamar, penghuni, serta memantau pembayaran dan laporan keuangan secara praktis dalam satu tampilan.

              .mb-3.mt-auto
               span.badge.bg-info.text-dark.me-1 MySQL
               span.badge.bg-info.text-dark.me-1 HTML
               span.badge.bg-info.text-dark.me-1 JavaScript
               span.badge.bg-info.text-dark.me-1 CSS

              

        // PROJECT 2
        .col-md-4.mb-4(
