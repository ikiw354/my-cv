// 🔥 SOCIAL MEDIA
.d-flex.justify-content-center.gap-4.mt-3(
  data-aos="fade-up"
  data-aos-anchor-placement="center-bottom"
)
  a.social-icon.fs-4(
    href=config.social.linkedin
    target="_blank"
  )
    i.bi.bi-linkedin

  a.social-icon.fs-4(
    href=config.social.instagram
    target="_blank"
  )
    i.bi.bi-instagram

  a.social-icon.fs-4(
    href=config.social.whatsapp
    target="_blank"
  )
    i.bi.bi-whatsapp

  a.social-icon.fs-4(
    href=config.social.telegram
    target="_blank"
  )
    i.bi.bi-telegram